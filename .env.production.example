# Copy this file to .env on the server. Do not commit the real .env file.

# Public ports exposed by the Docker Compose stack. Let 1Panel reverse-proxy
# the web port (8088 by default); the API port remains bound to 127.0.0.1.
AI_REVIEW_WEB_PORT=8088
AI_REVIEW_API_PORT=8770

# PostgreSQL managed by docker-compose.yml.
# Leave DATABASE_URL blank to use the internal postgres service automatically.
POSTGRES_DB=ai_design_review
POSTGRES_USER=ai_design_review
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5

# Generation integration. Keep mock mode disabled in production.
GENERATION_WORKER_API_KEY=replace-with-a-long-random-worker-key
GENERATION_ADMIN_API_KEY=replace-with-a-different-long-random-admin-key
GENERATION_JOB_LEASE_SECONDS=300
GENERATION_MAX_ARTIFACT_MB=50
MOCK_SOLIDWORKS_ENABLED=false

# PostgreSQL-backed background recognition. Keep this at 2 for the first
# production release unless Qwen/OCR capacity has been measured.
RECOGNITION_WORKER_CONCURRENCY=2
RECOGNITION_JOB_POLL_SECONDS=1
RECOGNITION_JOB_LEASE_SECONDS=900

# OCR routing. Use local RapidOCR for the Qwen recognition fallback path.
OCR_PROVIDER=rapidocr

# ERP iframe identity. The ERP sends URL-encoded JSON in this HttpOnly cookie:
# {"userId":"123","username":"admin","realName":"管理员","currentOrgId":"1","currentOrgName":"总部"}
# This compatibility mode is for integration testing only. Replace it with a
# signed JWT or ERP /me endpoint before accepting untrusted external users.
AI_REVIEW_IDENTITY_MODE=cookie_json
AI_REVIEW_SHOW_IDENTITY=true
ERP_IDENTITY_COOKIE_NAME=erp_review_identity
AI_REVIEW_FRAME_ANCESTORS=https://erp.datynk.com

# Qwen visual recognition and standardization chat.
QWEN_API_KEY=replace-with-your-qwen-api-key
QWEN_MODEL=qwen3.7-plus
QWEN_VISION_ENABLE_THINKING=false
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MAX_PAGES=3
QWEN_RENDER_DPI=220
QWEN_TIMEOUT_SECONDS=180

# RAGFlow. This must be an address reachable from the API container.
# Do not use 127.0.0.1 when RAGFlow is deployed outside this Compose stack.
RAGFLOW_BASE_URL=http://replace-with-ragflow-server:18080
RAGFLOW_API_KEY=replace-with-your-ragflow-api-key
RAGFLOW_COMPRESSION_DATASET_ID=replace-with-compression-dataset-id
RAGFLOW_COMPRESSION_DATASET_NAME=压缩弹簧
RAGFLOW_STANDARD_DOCUMENT_IDS={"GB/T 1239.2-2009":"replace-with-cold-document-id","GB/T 23934-2015":"replace-with-hot-document-id"}
RAGFLOW_TIMEOUT_SECONDS=12

# Build mirrors. Set either value blank when the server should use defaults.
DEBIAN_APT_MIRROR=mirrors.aliyun.com
PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple
