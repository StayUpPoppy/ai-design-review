# OCR routing: auto tries Baidu first and falls back to local RapidOCR.
OCR_PROVIDER=auto
BAIDU_OCR_API_KEY=replace-with-your-baidu-api-key
BAIDU_OCR_SECRET_KEY=replace-with-your-baidu-secret-key
# PaddleOCR-VL is asynchronous. These optional values control polling only.
BAIDU_DOC_PARSER_TIMEOUT_SECONDS=240
BAIDU_DOC_PARSER_POLL_SECONDS=5

# Geometry analysis is local and enabled by the API by default.
GEOMETRY_PROVIDER=local

# VLM/LLM review is optional. It must cite OCR/geometry evidence and must not invent dimensions.
VISION_PROVIDER=none

# Legacy optional Werk24 adapter. The default product path no longer uses it.
# W24TECHREAD_AUTH_TOKEN=replace-with-your-werk24-token
# W24TECHREAD_AUTH_REGION=eu
