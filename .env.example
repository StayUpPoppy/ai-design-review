# OCR routing: auto tries Baidu first and falls back to local RapidOCR.
OCR_PROVIDER=auto
BAIDU_OCR_API_KEY=replace-with-your-baidu-api-key
BAIDU_OCR_SECRET_KEY=replace-with-your-baidu-secret-key
# PaddleOCR-VL is asynchronous. These optional values control polling only.
BAIDU_DOC_PARSER_TIMEOUT_SECONDS=240
BAIDU_DOC_PARSER_POLL_SECONDS=5

# Geometry analysis is local and enabled by the API by default.
GEOMETRY_PROVIDER=local

# Qwen3.7-Plus direct visual recognition. DASHSCOPE_API_KEY is also accepted.
QWEN_API_KEY=replace-with-your-qwen-api-key
QWEN_MODEL=qwen3.7-plus
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MAX_PAGES=3
QWEN_RENDER_DPI=220

# VLM/LLM review is optional. It must cite OCR/geometry evidence and must not invent dimensions.
VISION_PROVIDER=none

# Legacy optional Werk24 adapter. The default product path no longer uses it.
# W24TECHREAD_AUTH_TOKEN=replace-with-your-werk24-token
# W24TECHREAD_AUTH_REGION=eu

# RAGFlow is used server-side for standard citations and AI chat context.
RAGFLOW_BASE_URL=http://127.0.0.1:18080
RAGFLOW_API_KEY=replace-with-your-ragflow-api-key
RAGFLOW_COMPRESSION_DATASET_ID=replace-with-compression-dataset-id
RAGFLOW_COMPRESSION_DATASET_NAME=压缩弹簧
RAGFLOW_STANDARD_DOCUMENT_IDS={"GB/T 1239.2-2009":"replace-with-cold-document-id","GB/T 23934-2015":"replace-with-hot-document-id"}
RAGFLOW_TIMEOUT_SECONDS=12

# PostgreSQL is the production source of truth for reviews and audit events.
# Leave DATABASE_URL blank for local JSON-only compatibility mode.
DATABASE_URL=
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
POSTGRES_DB=ai_design_review
POSTGRES_USER=ai_design_review
POSTGRES_PASSWORD=change-this-before-production

# Docker build mirrors. Set either value blank to use the image default source.
DEBIAN_APT_MIRROR=mirrors.aliyun.com
PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple
