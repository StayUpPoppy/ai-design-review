server {
    listen 80;
    server_name _;
    client_max_body_size 50m;
    add_header Content-Security-Policy "frame-ancestors ${AI_REVIEW_FRAME_ANCESTORS}" always;
    # Resolve the Compose service dynamically so an API container rebuild does
    # not leave Nginx forwarding requests to its previous container IP.
    resolver 127.0.0.11 ipv6=off valid=10s;
    set $api_upstream api;

    root /usr/share/nginx/html;
    index index.html;

    location /api/ {
        proxy_pass http://$api_upstream:8770;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 30s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
